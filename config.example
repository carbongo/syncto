# syncto global config: defaults for every repo, one key=value per line.
# Every key and what it does: syncto help

interval=120
watch=off
debounce=2
stale=0
mode=sync
branch=main
remote=origin
log=~/.local/state/syncto/syncto.log
log_max=2097152

# launchd and systemd have no ssh-agent: name a passphrase-less key for ssh remotes.
# key=~/.ssh/example_deploy_key
