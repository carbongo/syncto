# syncto example global config
#
# Copy to ${XDG_CONFIG_HOME:-$HOME/.config}/syncto/config. These are the defaults
# every target falls back to when its own options column doesn't override them.
# The list of repos to sync lives in a separate file — see targets.example.
# Nothing in this repo is read at runtime; real config lives outside it.
#
# Format: key=value, one per line. Blank lines and #-comments are ignored.

interval=120
watch=off
mode=sync
branch=main
remote=origin
log=~/.local/state/syncto/syncto.log

# Optional: schedulers (launchd/systemd) run with no ssh-agent in scope. If a target
# pushes/pulls over SSH, point git at a passphrase-less key explicitly instead of
# relying on an agent that won't be there:
#
#   key=~/.ssh/example_deploy_key
#
# syncto turns that into GIT_SSH_COMMAND="ssh -i ~/.ssh/example_deploy_key \
#   -o IdentitiesOnly=yes" for that target's git commands. You can also set
# GIT_SSH_COMMAND directly here (or per-target) for full control, e.g. a nonstandard
# port or a custom known_hosts file:
#
#   GIT_SSH_COMMAND=ssh -i ~/.ssh/example_deploy_key -o IdentitiesOnly=yes -p 2222
