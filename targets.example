# syncto targets: one repo per line, NAME<TAB>PATH<TAB>OPTIONS, with $HOME written as ~.
# Easier: syncto add NAME PATH [key=value ...]. Every option: syncto help

notes	~/notes	watch=on,prefix=notes (laptop),notify=notify-send "syncto" "notes needs you"
dotfiles	~/dotfiles	interval=600,peer=ssh -o BatchMode=yes example-host '~/.local/bin/syncto sync dotfiles'
