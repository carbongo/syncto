# systemd --user timer template for gitsync (Linux).
#
# Consumed by `gitsync --install-service`, which substitutes:
#   @INTERVAL@   seconds between scheduled passes (OnUnitActiveSec)
#
# Pairs with gitsync.service. systemd --user timers run WITHOUT an
# ssh-agent. If any target pushes over ssh, set a `key=` option (or an
# equivalent GIT_SSH_COMMAND escape hatch) in the gitsync config for that
# target, so pushes don't hang waiting for a passphrase prompt.
#
# Installed to: ${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/gitsync.timer
# Install with: gitsync --install-service
# Remove with:  gitsync --uninstall-service

[Unit]
Description=gitsync scheduled sync timer

[Timer]
OnBootSec=1min
OnUnitActiveSec=@INTERVAL@s
AccuracySec=15s
Persistent=true

[Install]
WantedBy=timers.target
