# systemd --user service template for gitsync (Linux).
#
# Consumed by `gitsync --install-service`, which substitutes:
#   @EXEC@   absolute path to the gitsync entry point (installed to
#            $HOME/.local/bin/gitsync). Invoked with a trailing `-d`
#            argument to run one scheduled pass.
#
# Pairs with gitsync.timer, which triggers this unit on a schedule.
# systemd --user services run WITHOUT an ssh-agent. If any target pushes
# over ssh, set a `key=` option (or an equivalent GIT_SSH_COMMAND escape
# hatch) in the gitsync config for that target, so pushes don't hang.
#
# Installed to: ${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/gitsync.service
# Install with: gitsync --install-service
# Remove with:  gitsync --uninstall-service

[Unit]
Description=gitsync scheduled sync pass
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=@EXEC@ -d
