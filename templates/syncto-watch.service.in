# systemd --user unit for syncto's watch daemon, rendered by syncto --install-service
# (@EXEC@ = entry point). Installed when a target has watch=on or remote_poll.

[Unit]
Description=syncto filesystem watch daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=@EXEC@ -w
# Come back after a crash; the delay stops a crash loop spinning the CPU.
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
